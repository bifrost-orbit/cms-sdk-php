{
    "name": "bifrost-orbit/cms-sdk",
    "description": "Read content from CMS Orbit: a PHP client for the delivery API, with SEO, sitemap, preview and webhook helpers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["cms", "headless-cms", "cms-orbit", "bifrost-orbit", "delivery-api"],
    "homepage": "https://docs.bifrostorbit.com/cms/developers/sdk-php",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "ext-curl": "Used by the built-in transport. Without it, PHP streams are used."
    },
    "autoload": {
        "psr-4": {
            "BifrostOrbit\\Cms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BifrostOrbit\\Cms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
